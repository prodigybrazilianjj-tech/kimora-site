STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SESSION_SECRET=
DATABASE_URL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
WHOLESALE_NOTIFY_TO=
ADMIN_DASHBOARD_TOKEN=
# Scoped credential for the in-person wholesale rep tool (/tools/wholesale).
# Unlocks wholesale invoicing ONLY — not orders/inventory/waitlist/shipping.
# Give this to a rep working the mat instead of ADMIN_DASHBOARD_TOKEN.
# Required for POST /api/wholesale/invoice (ADMIN_DASHBOARD_TOKEN also works).
WHOLESALE_REP_TOKEN=
# Scoped password for the resale-cert admin tool (/tools/wholesale-certs).
CERT_TOOL_PASSWORD=
PUBLIC_SITE_URL=
VITE_LAUNCH_AT=
# Server-side checkout launch gate. MUST be set to "true" to open checkout —
# any other value (including unset) returns HTTP 403 from /api/checkout.
# Default off = safe: prevents a direct POST from creating a real charge
# pre-launch even though the UI hides the shop.
CHECKOUT_ENABLED=
